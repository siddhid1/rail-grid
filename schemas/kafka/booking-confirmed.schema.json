    },
    "userId": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "scheduleId": {
      "type": "string"
    },
    "trainNumber": {
      "type": "string"
    },
    "trainName": {
      "type": "string"
    },
    "departureDate": {
      "type": "string"
    },
    "totalAmount": {
