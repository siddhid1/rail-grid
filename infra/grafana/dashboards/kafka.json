{
  "title": "IRCTC Kafka Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (service)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "p95 HTTP Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Booking Confirmed Total",
      "targets": [
        {
          "expr": "sum(booking_status_total{status=\"CONFIRMED\"})"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "DLQ Messages",
      "targets": [
        {
          "expr": "sum(kafka_messages_processed_total{status=\"dlq\"})"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Payment Captures",
      "targets": [
        {
          "expr": "sum(payment_captured_total)"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 6
      }
    }
  ]
}
